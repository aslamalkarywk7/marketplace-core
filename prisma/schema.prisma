// Marketplace Core — Prisma Schema
// Unified marketplace: Real Estate + Cars + General Products

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings      Listing[]
  orders        Order[]
  cartItems     CartItem[]
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum Category {
  REAL_ESTATE
  CARS
  PRODUCTS
  SERVICES
}

model Listing {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  description String   @db.Text
  category    Category
  priceCents  Int
  currency    String   @default("EGP")
  images      String[]
  location    String?
  condition   String?  // new / used
  specs       Json?    // category-specific: { rooms, area, year, mileage... }
  stock       Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([category, isActive])
  @@index([priceCents])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  listingId String
  qty       Int     @default(1)

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  totalCents    Int
  status        String   @default("pending")
  stripeId      String?
  address       String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  listingId String
  qty       Int
  priceCents Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id])
}
